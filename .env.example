# Copy to `.env` and edit. `.env` is gitignored; code reads it automatically.

# Persistent model/data cache, read by src/geoprobe/paths.py (falls back to
# HF_HOME, then ~/.cache/huggingface). On a server, point this at a mounted
# persistent volume so weights survive and code transfers unchanged:
# GEOPROBE_MODEL_CACHE=/mnt/persistent/hf

# Optional: run fully offline once weights are cached (no network calls).
# Standard Hugging Face variable, honored by the model loader
# (src/geoprobe/models/loader.py) via huggingface_hub:
# HF_HUB_OFFLINE=1

# Hugging Face token — read by huggingface_hub when the model loader
# (src/geoprobe/models/loader.py) downloads gated weights (e.g. Llama):
# HF_TOKEN=
